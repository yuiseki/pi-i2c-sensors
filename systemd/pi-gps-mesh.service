[Unit]
Description=pi-gps-mesh: use the attached Meshtastic node's GPS when there is no USB receiver
After=local-fs.target

[Service]
Type=simple
User=yuiseki
# The meshtastic package lives in its own venv; this is the only thing here
# that needs it, and pi-gps stays dependency-light because of it.
ExecStart=/home/yuiseki/.venv-meshtastic/bin/python /usr/local/bin/pi-gps-mesh
Restart=always
RestartSec=10
Nice=10

[Install]
WantedBy=multi-user.target
