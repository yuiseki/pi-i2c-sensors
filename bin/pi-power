#!/usr/bin/env python3
"""pi-power - report the UPS/battery state of a Raspberry Pi.

Two power boards are supported and picked automatically:

  x120x    Geekworm/SupTronics X120x (X1200/X1201/X1202) UPS HAT. The
           `x120x` kernel driver (dtoverlay=x120x) exposes the pack through
           the standard power_supply class, so this is a plain sysfs read -
           no I2C access and no root needed.
  pisugar  PiSugar 2/3. pisugar-server speaks a line protocol on TCP 8423.

The output is the same for both, and is the same three lines the original
PiSugar-only shell version printed, because the map app parses them:

    battery: 94
    battery_v: 4.1725
    battery_power_plugged: true

`--daemon` keeps reading, publishes the same numbers to /dev/shm/pi-power for
other processes, and enforces a low-battery policy: warn on the console, then
shut down. Both only ever fire while the pack is actually on battery, and only
after the level has stayed low continuously - a single dip cannot halt the Pi.

Environment overrides (used by the tests, handy for debugging):
    PI_POWER_SYSFS      sysfs root, default /sys
    PI_POWER_PISUGAR    host:port of pisugar-server, default 127.0.0.1:8423
"""
import argparse
import os
import socket
import subprocess
import sys
import time
from pathlib import Path

SYSFS = Path(os.environ.get("PI_POWER_SYSFS", "/sys"))
PISUGAR = os.environ.get("PI_POWER_PISUGAR", "127.0.0.1:8423")

# The x120x driver names its power_supply nodes after the board.
X120X_BATTERY = "x120x-battery"
X120X_AC = "x120x-ac"

# Where --daemon publishes, matching the other feeds in this repo.
# tmpfs, so a once-a-poll write costs the microSD nothing.
PUBLISH = Path(os.environ.get("PI_POWER_PUBLISH", "/dev/shm/pi-power"))


class Unavailable(Exception):
    """The backend this was asked for is not on this machine."""


def _read(path):
    try:
        return path.read_text().strip()
    except OSError:
        return None


def _read_int(path):
    raw = _read(path)
    try:
        return int(raw)
    except (TypeError, ValueError):
        return None


def read_x120x():
    """Read the X120x pack out of /sys/class/power_supply."""
    ps = SYSFS / "class" / "power_supply"
    battery = ps / X120X_BATTERY
    if not battery.is_dir():
        raise Unavailable(
            "no %s under %s - is dtoverlay=x120x in config.txt?" % (X120X_BATTERY, ps)
        )

    percent = _read_int(battery / "capacity")
    if percent is None:
        # Some builds expose only the coulomb counters; derive the same number.
        now = _read_int(battery / "charge_now")
        full = _read_int(battery / "charge_full")
        if now is None or not full:
            raise Unavailable("%s reports neither capacity nor charge_now/full" % battery)
        percent = round(now * 100 / full)

    micro_volts = _read_int(battery / "voltage_now")
    volts = micro_volts / 1e6 if micro_volts is not None else None

    online = _read_int(ps / X120X_AC / "online")
    if online is None:
        # No AC node (or unreadable): the pack's own status still tells us
        # whether something is feeding it.
        online = 1 if (_read(battery / "status") or "") in ("Charging", "Full") else 0

    return percent, volts, bool(online)


def read_pisugar():
    """Ask pisugar-server for the same three values over TCP."""
    host, _, port = PISUGAR.partition(":")
    addr = (host, int(port or 8423))

    def query(key):
        try:
            with socket.create_connection(addr, timeout=2) as sock:
                sock.sendall(("get %s\n" % key).encode())
                reply = sock.recv(256).decode()
        except OSError as exc:
            raise Unavailable("pisugar-server at %s: %s" % (PISUGAR, exc))
        # Replies look like "battery: 100".
        for line in reply.splitlines():
            name, sep, value = line.partition(":")
            if sep and name.strip() == key:
                return value.strip()
        raise Unavailable("pisugar-server gave no %s (said %r)" % (key, reply))

    percent = query("battery")
    volts = query("battery_v")
    plugged = query("battery_power_plugged").lower() == "true"
    return percent, volts, plugged


BACKENDS = {"x120x": read_x120x, "pisugar": read_pisugar}
# x120x first: it is a local sysfs read, so probing it is free and cannot hang.
ORDER = ("x120x", "pisugar")


def detect(preferred="auto"):
    """Return (name, percent, volts, plugged) for the first backend that answers."""
    names = ORDER if preferred == "auto" else (preferred,)
    reasons = []
    for name in names:
        try:
            return (name, *BACKENDS[name]())
        except Unavailable as exc:
            reasons.append("%s: %s" % (name, exc))
    raise Unavailable("no power backend responded\n  " + "\n  ".join(reasons))


class Guard:
    """The low-battery policy, kept free of I/O so it can be tested directly.

    Both actions are edge-triggered on "has been this low, on battery, for a
    while": the level has to stay at or below the threshold continuously for
    `dwell_s`. Charging, or the level coming back up, re-arms the wait from
    scratch. A shutdown latches - there is nothing sensible to do twice.
    """

    def __init__(self, warn_pct, crit_pct, dwell_s, repeat_s, on_warn, on_shutdown):
        self.warn_pct = warn_pct
        self.crit_pct = crit_pct
        self.dwell_s = dwell_s
        self.repeat_s = repeat_s
        self.on_warn = on_warn
        self.on_shutdown = on_shutdown
        self.warn_since = None
        self.crit_since = None
        self.warned_at = None
        self.halted = False

    def _reset(self):
        self.warn_since = None
        self.crit_since = None
        self.warned_at = None

    def step(self, now, percent, plugged):
        # On mains, or with no reading at all, there is no policy to enforce.
        if plugged or percent is None:
            self._reset()
            return

        if percent <= self.warn_pct:
            if self.warn_since is None:
                self.warn_since = now
            elif now - self.warn_since >= self.dwell_s and (
                self.warned_at is None or now - self.warned_at >= self.repeat_s
            ):
                self.warned_at = now
                self.on_warn(percent)
        else:
            self.warn_since = None
            self.warned_at = None

        if percent <= self.crit_pct:
            if self.crit_since is None:
                self.crit_since = now
            elif now - self.crit_since >= self.dwell_s and not self.halted:
                self.halted = True
                self.on_shutdown(percent)
        else:
            self.crit_since = None


def publish(percent, volts, plugged):
    """Write the current state where other processes can read it."""
    line = "%s %s %d 1\n" % (
        percent if percent is not None else "-1",
        format_volts(volts),
        1 if plugged else 0,
    )
    try:
        PUBLISH.write_text(line)
    except OSError:
        pass  # /dev/shm missing is not a reason to stop watching the battery


def wall(message):
    """Broadcast to every terminal, including the HDMI console."""
    try:
        subprocess.run(["wall", message], check=False,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        pass
    print(message, file=sys.stderr, flush=True)


def poweroff():
    subprocess.run(["systemctl", "poweroff"], check=False)


def run_daemon(args):
    """Poll, publish, and enforce the policy until killed."""
    def on_warn(percent):
        wall("pi-power: battery at %d%% on battery power. "
             "Shutting down automatically at %d%%." % (percent, args.crit))

    def on_shutdown(percent):
        if args.dry_run:
            wall("pi-power: battery at %d%%. Would shut down now (--dry-run)."
                 % percent)
            return
        wall("pi-power: battery at %d%%. Shutting down now." % percent)
        poweroff()

    guard = Guard(args.warn, args.crit, args.dwell, args.repeat, on_warn, on_shutdown)
    deadline = time.monotonic() + args.exit_after if args.exit_after else None
    while True:
        try:
            backend, percent, volts, plugged = detect(args.backend)
        except Unavailable as exc:
            # A backend that goes missing mid-run (driver reload, server
            # restart) must not take the policy down with it; keep looking.
            print("pi-power: %s" % exc, file=sys.stderr, flush=True)
            percent = volts = None
            plugged = True  # unknown: do not halt on a reading we do not have
        else:
            if isinstance(percent, str):
                percent = int(percent)
        publish(percent, volts, plugged)
        guard.step(time.monotonic(), percent, plugged)
        if deadline is not None and time.monotonic() >= deadline:
            return 0
        time.sleep(args.interval)


def format_volts(volts):
    """Match the PiSugar output: a bare number, no trailing-zero padding."""
    if volts is None:
        return "unknown"
    if isinstance(volts, str):
        return volts
    return ("%.4f" % volts).rstrip("0").rstrip(".")


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument(
        "--backend", choices=("auto", *ORDER), default="auto",
        help="force a backend instead of auto-detecting (default: auto)")
    parser.add_argument(
        "--which", action="store_true",
        help="print only the name of the backend in use")
    parser.add_argument(
        "--daemon", action="store_true",
        help="keep polling, publish to %s, and enforce the low-battery policy" % PUBLISH)
    parser.add_argument(
        "--interval", type=float, default=10.0, metavar="S",
        help="--daemon poll interval in seconds (default: %(default)s)")
    parser.add_argument(
        "--warn", type=int, default=10, metavar="PCT",
        help="--daemon: warn on the console at or below this %% (default: %(default)s)")
    parser.add_argument(
        "--crit", type=int, default=3, metavar="PCT",
        help="--daemon: shut down at or below this %% (default: %(default)s)")
    parser.add_argument(
        "--dwell", type=float, default=60.0, metavar="S",
        help="--daemon: how long the level must stay low before acting "
             "(default: %(default)s)")
    parser.add_argument(
        "--repeat", type=float, default=300.0, metavar="S",
        help="--daemon: how often to repeat the warning (default: %(default)s)")
    parser.add_argument(
        "--dry-run", action="store_true",
        help="--daemon: say what the policy would do instead of shutting down")
    parser.add_argument(
        "--exit-after", type=float, default=0.0, metavar="S",
        help=argparse.SUPPRESS)  # tests only: stop the loop after S seconds
    args = parser.parse_args()

    if args.daemon:
        if args.crit > args.warn:
            parser.error("--crit (%d) must not be above --warn (%d)"
                         % (args.crit, args.warn))
        try:
            return run_daemon(args)
        except KeyboardInterrupt:
            return 0

    try:
        name, percent, volts, plugged = detect(args.backend)
    except Unavailable as exc:
        print("pi-power: %s" % exc, file=sys.stderr)
        return 1

    if args.which:
        print(name)
        return 0

    publish(percent, volts, plugged)
    print("battery: %s" % percent)
    print("battery_v: %s" % format_volts(volts))
    print("battery_power_plugged: %s" % ("true" if plugged else "false"))
    return 0


if __name__ == "__main__":
    sys.exit(main())
