#!/usr/bin/env python3
"""pi-gps-mesh : publish a Meshtastic node's own GPS fix as this host's position.

The deck often has no USB GPS mouse attached, but it usually has a Meshtastic
node plugged into it, and that node has a GPS. The node is physically on the
deck, so its fix *is* the deck's position -- there is no reason to have a
position and not use it.

Writes the same "<lat> <lon> <fix> <sats_used> <sats_in_view>" line to the same
/dev/shm/pi-gps that pi-gps writes, so every consumer (pi-poi, pi-here, the
map's status bar) works unchanged and does not need to know which receiver is
speaking.

Three rules keep the two producers from fighting:

**pi-gps wins.** While a USB NMEA receiver is present this stands down and
publishes nothing. A dedicated receiver outranks a side effect of the radio,
and it means the file has exactly one writer at a time.

**Only LOC_INTERNAL counts.** A node's position can also come from a manual
setting or from the mesh; neither is this host's GPS. Publishing a hand-typed
coordinate as a fix would put the deck confidently in the wrong place.

**Stale is silence.** If the node's fix is older than --max-age, nothing is
published, so /dev/shm/pi-gps goes stale and consumers read that as "no GPS" --
the same contract pi-gps already has. A wrong position is worse than none.

It polls rather than holding the port open. A connect costs about 0.6s, and
keeping the port would make `meshtastic ...` fail for as long as this runs --
on a deck that exists to be tinkered with, that is the wrong trade.

Environment overrides (used by the tests):
    PI_GPS_MESH_OUT       output file, default /dev/shm/pi-gps
    PI_GPS_MESH_PORT      node device path (default: autodetect)
    PI_GPS_MESH_BYID      by-id directory, default /dev/serial/by-id
"""
import argparse
import fnmatch
import glob
import os
import sys
import time

OUT = os.environ.get("PI_GPS_MESH_OUT", "/dev/shm/pi-gps")
BY_ID = os.environ.get("PI_GPS_MESH_BYID", "/dev/serial/by-id")

# A USB NMEA receiver, by the same names pi-gps looks for. Its presence is what
# makes this stand down.
GPS_PATTERNS = ("*GPS*", "*gps*", "*GNSS*", "*gnss*", "*u-blox*", "*u_blox*")

# A Meshtastic node. ESP32 boards with native USB enumerate as an Espressif
# JTAG/serial unit; nRF52 boards (RAK, T-Echo) as their own names. Matched by
# by-id name only, never a bare ttyACM -- see pi-gps for why that matters.
NODE_PATTERNS = ("*Espressif*", "*RAK*", "*Nordic*", "*Seeed*", "*Heltec*")


def find_usb_gps():
    for pat in GPS_PATTERNS:
        g = sorted(glob.glob(os.path.join(BY_ID, pat)))
        if g:
            return g[0]
    return None


def find_node():
    forced = os.environ.get("PI_GPS_MESH_PORT")
    if forced:
        return forced if os.path.exists(forced) else None
    for pat in NODE_PATTERNS:
        for path in sorted(glob.glob(os.path.join(BY_ID, pat))):
            # Not the GPS receiver, if one happens to match both.
            if not any(fnmatch.fnmatch(os.path.basename(path), p)
                       for p in GPS_PATTERNS):
                return path
    return None


def read_node_position(port, timeout=20):
    """The node's own position, or None. Opens and closes the port each time.

    Imported here rather than at module scope so the file stays runnable (and
    testable) on a host without the meshtastic package.
    """
    try:
        import meshtastic.serial_interface as si
    except ImportError:
        print("pi-gps-mesh: meshtastic package not installed", file=sys.stderr)
        return None
    iface = None
    try:
        iface = si.SerialInterface(port)
        me = iface.getMyNodeInfo()
        if not me:
            return None
        node = iface.nodes.get(me["user"]["id"]) or {}
        return node.get("position") or None
    except Exception as exc:                            # noqa: BLE001
        # A busy port (someone running the CLI), an unplug, a protocol hiccup.
        # None of it is fatal: skip this round and try the next.
        print("pi-gps-mesh: %s" % exc, file=sys.stderr)
        return None
    finally:
        if iface is not None:
            try:
                iface.close()
            except Exception:                           # noqa: BLE001
                pass


def usable(pos, max_age, now=None):
    """(lat, lon, sats) if this is a live fix from the node's own receiver."""
    if not pos:
        return None
    if pos.get("locationSource") != "LOC_INTERNAL":
        return None
    lat, lon = pos.get("latitude"), pos.get("longitude")
    if lat is None or lon is None:
        return None
    if lat == 0 and lon == 0:
        return None                 # null island: the node has no fix yet
    t = pos.get("time") or 0
    if not t:
        return None
    age = (now if now is not None else time.time()) - t
    if age < 0:
        age = 0                     # the node's clock is ahead of ours
    if age > max_age:
        return None
    return lat, lon, int(pos.get("satsInView") or 0)


def publish(out, lat, lon, sats):
    # Same five fields as pi-gps. fix=1: a LOC_INTERNAL position that is not
    # stale is a fix by definition -- the node does not report one otherwise.
    tmp = out + ".tmp"
    try:
        with open(tmp, "w") as fh:
            fh.write("%.6f %.6f %d %d %d\n" % (lat, lon, 1, sats, sats))
        os.replace(tmp, out)
        return True
    except OSError:
        return False


def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    # Shorter than pi-gps-track's staleness threshold (15s by default), which
    # is what decides whether the published file still counts as live. At 20s
    # the file spent five seconds of every cycle looking dead, and the track
    # flapped between "fix" and "no receiver".
    ap.add_argument("--interval", type=float, default=10.0,
                    help="seconds between polls (default 10; must stay under "
                         "pi-gps-track's PI_GPS_TRACK_STALE, default 15)")
    ap.add_argument("--max-age", type=float, default=120.0,
                    help="ignore a node fix older than this many seconds "
                         "(default 120, matching the node's gps update interval)")
    ap.add_argument("--once", action="store_true",
                    help="poll once and exit, for checking by hand")
    args = ap.parse_args(argv)

    tty = sys.stdout.isatty()
    said = None

    def announce(state):
        nonlocal said
        if state != said:
            print("pi-gps-mesh: %s" % state, flush=True)
            said = state

    while True:
        gps = find_usb_gps()
        if gps:
            # pi-gps owns the file while a real receiver is attached.
            announce("standing down: USB GPS present (%s)" % os.path.basename(gps))
        else:
            node = find_node()
            if not node:
                announce("no Meshtastic node attached")
            else:
                pos = read_node_position(node)
                got = usable(pos, args.max_age)
                if got:
                    lat, lon, sats = got
                    publish(OUT, lat, lon, sats)
                    announce("publishing from %s" % os.path.basename(node))
                    if tty:
                        print("  %.6f %.6f  sats=%d -> %s"
                              % (lat, lon, sats, OUT), flush=True)
                else:
                    why = "no fix yet"
                    if pos and pos.get("locationSource") != "LOC_INTERNAL":
                        why = "node position is %s, not its own GPS" % pos.get("locationSource")
                    elif pos and pos.get("time"):
                        why = "node fix is stale"
                    announce("not publishing: %s" % why)
        if args.once:
            return 0
        time.sleep(args.interval)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        print("\nbye")
