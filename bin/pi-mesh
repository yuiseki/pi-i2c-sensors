#!/usr/bin/env python3
"""pi-mesh : everything the attached Meshtastic node knows, on the map.

The node plugged into this deck is the deck's window onto the mesh. It knows
two things worth having, and this publishes both:

**Where the other nodes are** -> the "mesh" layer of the marker feed, so the map
draws them. Format is the feed's own: "<id> <lat> <lon> <epoch> <shortName>".
The map colours a marker by its id, so these get the node colour and POI
searches keep theirs, and a position older than ten minutes is drawn faded.

**Where this host is**, when there is no USB GPS mouse attached -> the same
/dev/shm/pi-gps that pi-gps writes. The node is on the deck, so its fix is the
deck's fix; there is no reason to have a position and not use it.

**Where this host is, told to the node** (--share-position), when a USB receiver
*is* attached and the node's own GPS is not to be trusted. pi4-deck is that
case: a u-blox mouse that fixes and a C6L whose Grove GPS rarely does, so the
deck knows where it is while the mesh does not. Writing costs a flash erase, so
it happens on 50 m of movement or every 5 minutes, whichever comes first.

All of them live here rather than in separate services for one blunt reason:
**there is one serial port**. Two processes polling the same node fight over it,
and while either holds it every `meshtastic ...` command fails. That is exactly
how the standalone bridge that used to do the third job died. One owner, one
connection, all three jobs.

Sharing is off by default and is refused outright without a receiver attached,
because the second and third jobs are opposites: with no receiver this process
*writes* the position file from the node's own fix, and feeding that back would
launder a measured position into a hand-set one.

Three rules decide when NOT to publish a position, which is the part that
matters -- a confidently wrong position is worse than none:

- **pi-gps wins.** While a USB NMEA receiver is present this publishes no
  position of its own, so the file has exactly one writer at a time.
- **Only LOC_INTERNAL counts** for this host. A node position can also be
  hand-set or heard over the mesh; neither is this deck's GPS.
- **Stale is silence.** Past --max-age nothing is published, the file ages out,
  and consumers read that as "no GPS" -- the contract pi-gps already has.

The node feed is different: a node's last known position is worth drawing long
after it was measured, which is why the map fades rather than drops it. So old
node positions are published with their real timestamp and left to fade.

Polling and publishing are separate rates. The file's mtime is not "this fix is
new", it is "a publisher is alive": the map calls /dev/shm/pi-gps stale after
two seconds, and pi-gps satisfies that by rewriting at 1 Hz while holding the
last position. Publishing only at the poll rate makes the map's GPS indicator
flap.

Environment overrides (used by the tests):
    PI_MESH_OUT_GPS       position file, default /dev/shm/pi-gps
    PI_MESH_MARKERS       marker feed, default /dev/shm/pi-mesh-nodes
    PI_MESH_LAYERS        layer store, default /dev/shm/pi-poi-layers.json
    PI_MESH_PORT          node device path (default: autodetect)
    PI_MESH_BYID          by-id directory, default /dev/serial/by-id
"""
import argparse
import fnmatch
import glob
import math
import os
import sys
import time

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)),
                                "..", "pi-hear"))
sys.path.append("/home/yuiseki/src/pi-hear")

OUT_GPS = os.environ.get("PI_MESH_OUT_GPS", "/dev/shm/pi-gps")
MARKERS = os.environ.get("PI_MESH_MARKERS", "/dev/shm/pi-mesh-nodes")
LAYERS = os.environ.get("PI_MESH_LAYERS", "/dev/shm/pi-poi-layers.json")
# Not in /dev/shm: this one has to survive a reboot, not just a restart.
SHARE_STATE = os.environ.get("PI_MESH_SHARE_STATE",
                            os.path.expanduser("~/.pi-mesh-shared"))
BY_ID = os.environ.get("PI_MESH_BYID", "/dev/serial/by-id")

# The layer these markers live in. geo.RESERVED_LAYERS keeps "clear the map"
# from taking them off: they are not a search result.
LAYER = "mesh"

GPS_PATTERNS = ("*GPS*", "*gps*", "*GNSS*", "*gnss*", "*u-blox*", "*u_blox*")
# ESP32 boards with native USB enumerate as an Espressif JTAG/serial unit;
# nRF52 boards (RAK, T-Echo) under their own names. By by-id name only, never a
# bare ttyACM -- see pi-gps for why taking that number breaks its real owner.
NODE_PATTERNS = ("*Espressif*", "*RAK*", "*Nordic*", "*Seeed*", "*Heltec*")


def find_usb_gps():
    for pat in GPS_PATTERNS:
        g = sorted(glob.glob(os.path.join(BY_ID, pat)))
        if g:
            return g[0]
    return None


def find_node():
    forced = os.environ.get("PI_MESH_PORT")
    if forced:
        return forced if os.path.exists(forced) else None
    for pat in NODE_PATTERNS:
        for path in sorted(glob.glob(os.path.join(BY_ID, pat))):
            if not any(fnmatch.fnmatch(os.path.basename(path), p)
                       for p in GPS_PATTERNS):
                return path
    return None


def read_node(port, while_open=None):
    """(my_node_id, nodes dict) from the attached node, or (None, {}).

    `while_open` is called with the open interface before it is closed. That is
    the whole reason the position-sharing job lives in this process: opening the
    port a second time to do it would fail while this one holds it.

    Imported here rather than at module scope so this stays runnable and
    testable on a host without the meshtastic package.
    """
    try:
        import meshtastic.serial_interface as si
    except ImportError:
        print("pi-mesh: meshtastic package not installed", file=sys.stderr)
        return None, {}
    iface = None
    try:
        iface = si.SerialInterface(port)
        me = iface.getMyNodeInfo()
        mine = me["user"]["id"] if me else None
        nodes = dict(iface.nodes or {})
        if while_open is not None:
            while_open(iface)
        return mine, nodes
    except Exception as exc:                            # noqa: BLE001
        # A busy port, an unplug, a protocol hiccup. Skip this round.
        print("pi-mesh: %s" % exc, file=sys.stderr)
        return None, {}
    finally:
        if iface is not None:
            try:
                iface.close()
            except Exception:                           # noqa: BLE001
                pass


def own_position(nodes, mine, max_age, now=None):
    """(lat, lon, sats) if this host's node has a live fix of its own."""
    pos = (nodes.get(mine) or {}).get("position") if mine else None
    if not pos or pos.get("locationSource") != "LOC_INTERNAL":
        return None
    lat, lon = pos.get("latitude"), pos.get("longitude")
    if lat is None or lon is None or (lat == 0 and lon == 0):
        return None
    t = pos.get("time") or 0
    if not t:
        return None
    age = max(0.0, (now if now is not None else time.time()) - t)
    if age > max_age:
        return None
    return lat, lon, int(pos.get("satsInView") or 0)


def receiver_fix(path, max_age, now=None):
    """(lat, lon) from a USB receiver's position file, or None.

    Same five fields and the same staleness contract pi-gps publishes: an old
    file means "no GPS", not "the last place we saw one".
    """
    try:
        age = (now if now is not None else time.time()) - os.path.getmtime(path)
        if age > max_age:
            return None
        with open(path) as fh:
            parts = fh.read().split()
        lat, lon, fix = float(parts[0]), float(parts[1]), int(parts[2])
    except (OSError, ValueError, IndexError):
        return None
    return (lat, lon) if fix >= 1 else None


def may_share(enabled, usb_gps):
    """Whether this host's fix may be written into the attached node.

    It may only when a real receiver is attached. Without one, the position
    file is written by *this* process out of the node's own fix, and sending
    that back would launder a measured position into a hand-set one -- the
    node would then report LOC_MANUAL forever, and the freshness rule that
    keeps a dead fix off the map would no longer apply to it.
    """
    return bool(enabled and usb_gps)


def haversine_m(a, b):
    lat1, lon1 = a
    lat2, lon2 = b
    r = 6371000.0
    p1, p2 = math.radians(lat1), math.radians(lat2)
    dphi = math.radians(lat2 - lat1)
    dlmb = math.radians(lon2 - lon1)
    h = (math.sin(dphi / 2) ** 2
         + math.cos(p1) * math.cos(p2) * math.sin(dlmb / 2) ** 2)
    return 2 * r * math.asin(math.sqrt(h))


def load_shared(path):
    """(lat, lon, when) last written into the node, or None.

    A missing or damaged file is "no history", not an error: the cost is one
    extra write, and refusing to start would cost the map its node markers.
    """
    try:
        with open(path) as fh:
            lat, lon, when = fh.read().split()
        return float(lat), float(lon), float(when)
    except (OSError, ValueError):
        return None


def save_shared(path, lat, lon, when):
    tmp = path + ".tmp"
    try:
        with open(tmp, "w") as fh:
            fh.write("%.6f %.6f %.3f\n" % (lat, lon, when))
        os.replace(tmp, path)
    except OSError as exc:
        print("pi-mesh: could not record the shared position: %s" % exc,
              file=sys.stderr)


def share_due(fix, last, move_m, max_interval, now=None):
    """(should_write, why). Writing costs a flash erase, so this is stingy.

    setFixedPosition writes the device's config, which is NVS-backed. At a 10s
    poll an always-write rule would be ~8600 erases a day for a deck sitting on
    a desk. Distance is the real trigger; the interval is only so a parked node
    does not look like it stopped reporting.
    """
    if last is None:
        return True, "first fix"
    if haversine_m(last[:2], fix) >= move_m:
        return True, "moved"
    age = (now if now is not None else time.time()) - last[2]
    if age >= max_interval:
        return True, "heartbeat (%ds)" % int(max_interval)
    return False, ""


def share_position(setter, fix, last, move_m, max_interval, now=None):
    """Write the fix into the node if it is due. Returns why, or None.

    A failed write returns None on purpose: recording it as done would suppress
    every retry until the interval elapsed, turning one bad poll into minutes
    of a silently wrong position on the mesh.
    """
    due, why = share_due(fix, last, move_m, max_interval, now=now)
    if not due:
        return None
    try:
        setter(fix[0], fix[1], 0)
    except Exception as exc:                            # noqa: BLE001
        print("pi-mesh: could not set the node position: %s" % exc,
              file=sys.stderr)
        return None
    return why


def safe_name(name, fallback):
    """One field, no spaces: the feed is whitespace-separated and name is last.

    The map parses with a stream extractor, so a name with a space in it would
    silently lose everything after the first word.
    """
    s = "".join(ch for ch in str(name or "") if ch.isprintable())
    s = "_".join(s.split())
    return s or fallback


def marker_lines(nodes, mine):
    """One line per other node that has a position.

    Our own node is left out on purpose: the map draws this host separately,
    in its own colour, from /dev/shm/pi-gps-lastfix. Publishing it here too
    would put two markers on one spot.
    """
    out = []
    for nid, node in sorted(nodes.items()):
        if mine and nid == mine:
            continue
        pos = (node or {}).get("position") or {}
        lat, lon = pos.get("latitude"), pos.get("longitude")
        if lat is None or lon is None or (lat == 0 and lon == 0):
            continue
        # A node's last known position is worth drawing long after it was
        # measured -- the map fades it rather than dropping it -- so the real
        # timestamp goes out even when it is old. lastHeard is the fallback for
        # a position that arrived without one.
        when = int(pos.get("time") or node.get("lastHeard") or 0)
        user = (node or {}).get("user") or {}
        ident = str(nid).lstrip("!") or "node"
        name = safe_name(user.get("shortName") or user.get("longName"), ident)
        out.append("%s %.6f %.6f %d %s" % (ident, float(lat), float(lon),
                                           when, name))
    return "\n".join(out)


def publish_gps(out, lat, lon, sats):
    # Same five fields as pi-gps. fix=1: a LOC_INTERNAL position that is not
    # stale is a fix by definition.
    tmp = out + ".tmp"
    try:
        with open(tmp, "w") as fh:
            fh.write("%.6f %.6f %d %d %d\n" % (lat, lon, 1, sats, sats))
        os.replace(tmp, out)
        return True
    except OSError:
        return False


def publish_markers(block):
    """Into the shared layer store, so a POI search and this can coexist."""
    try:
        import geo
    except ImportError:                                 # pragma: no cover
        print("pi-mesh: geo module not importable; not publishing markers",
              file=sys.stderr)
        return False
    try:
        geo.update_layer(LAYER, block, markers=MARKERS, path=LAYERS)
        return True
    except OSError as exc:
        print("pi-mesh: %s" % exc, file=sys.stderr)
        return False


def build_parser():
    ap = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--interval", type=float, default=10.0,
                    help="seconds between reads of the node (default 10). Each "
                         "read briefly occupies the port")
    ap.add_argument("--max-age", type=float, default=120.0,
                    help="ignore this host's own fix once it is older than this "
                         "(default 120). Other nodes' positions are published "
                         "however old and left to fade")
    # Not the poll rate. The map calls /dev/shm/pi-gps stale after 2s, and a
    # poll costs ~0.6s inside the same loop; at 1s the gap touched that window
    # once per poll.
    ap.add_argument("--publish-every", type=float, default=0.5,
                    help="seconds between rewrites of the position file "
                         "(default 0.5; consumers read mtime as liveness)")
    ap.add_argument("--no-gps", action="store_true",
                    help="publish node markers only, never this host's position")
    ap.add_argument("--share-position", action="store_true",
                    help="write this host's USB-GPS fix into the attached "
                         "node's fixed position, so the rest of the mesh can "
                         "see this deck. Off by default: it writes to the "
                         "node's flash, and it is only correct on a host that "
                         "has a receiver of its own")
    ap.add_argument("--share-move-m", type=float, default=50.0,
                    help="metres of movement that trigger a write (default 50)")
    ap.add_argument("--share-every", type=float, default=300.0,
                    help="seconds after which a stationary deck writes anyway "
                         "(default 300)")
    ap.add_argument("--once", action="store_true",
                    help="poll once and exit, for checking by hand")
    return ap


def main(argv=None):
    args = build_parser().parse_args(argv)
    tty = sys.stdout.isatty()
    said = None
    last = None            # (lat, lon, sats) from the most recent good read
    next_poll = 0.0
    # Loaded rather than started empty, so a restart is not a first fix.
    shared = load_shared(SHARE_STATE)

    def announce(state):
        nonlocal said
        if state != said:
            print("pi-mesh: %s" % state, flush=True)
            said = state

    while True:
        now = time.time()
        node = find_node()
        if not node:
            last = None
            announce("no Meshtastic node attached")
        elif now >= next_poll or args.once:
            next_poll = now + args.interval
            # Decided before the port is opened, because the write happens
            # inside that one connection.
            gps = find_usb_gps()
            fix = (receiver_fix(OUT_GPS, args.max_age)
                   if may_share(args.share_position, gps) else None)
            told = []

            def while_open(iface, fix=fix, told=told):
                if fix is None:
                    return
                why = share_position(iface.localNode.setFixedPosition, fix,
                                     shared, args.share_move_m,
                                     args.share_every)
                if why:
                    told.append((fix[0], fix[1], time.time(), why))

            mine, nodes = read_node(node, while_open=while_open)
            if told:
                lat, lon, when, why = told[0]
                shared = (lat, lon, when)
                save_shared(SHARE_STATE, lat, lon, when)
                print("pi-mesh: told the node it is at %.6f,%.6f (%s)"
                      % (lat, lon, why), flush=True)
            if nodes:
                block = marker_lines(nodes, mine)
                publish_markers(block)
                n = len(block.splitlines()) if block else 0
                if args.no_gps or gps:
                    # pi-gps owns the position file while a real receiver is
                    # attached; drop what we held so an unplug does not leave
                    # us republishing a position from minutes ago.
                    last = None
                    announce("%d node(s) on the map; position left to %s"
                             % (n, "pi-gps" if gps else "nobody"))
                else:
                    got = own_position(nodes, mine, args.max_age)
                    last = got
                    announce("%d node(s) on the map; position %s"
                             % (n, "from the node" if got else "not published"))
                if tty and got_str(last):
                    print("  %s" % got_str(last), flush=True)
            else:
                announce("node unreadable this round")

        if last is not None and not args.no_gps:
            publish_gps(OUT_GPS, *last)

        if args.once:
            return 0
        time.sleep(args.publish_every)


def got_str(last):
    return "" if last is None else "%.6f %.6f sats=%d" % last


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        print("\nbye")
